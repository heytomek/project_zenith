{
  "name": "project-zenith",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "lint:web": "bun run --cwd apps/web lint",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "new": "bun upgrade --latest && bun update --latest"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
