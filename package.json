{
  "name": "project-zenith",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "lint:web": "bun run --cwd apps/web lint",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "test:commons": "bun test tests/commons",
    "test:coordination": "bun test tests/coordination",
    "examples:coordination": "bun scripts/export-coordination.ts",
    "start:web": "bun run --cwd apps/web start"
  }
}
